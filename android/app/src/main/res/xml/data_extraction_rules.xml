<?xml version="1.0" encoding="utf-8"?>
<!-- Files and history stay on this device: excluded from cloud backup and device transfer.
     1.5 (ADR-054, FR-LIB-20): My Documents (files/library/) is listed explicitly too; the
     "file" domain already covers it, the line documents the promise. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="file" path="library/" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="file" path="library/" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
