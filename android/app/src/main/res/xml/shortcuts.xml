<?xml version="1.0" encoding="utf-8"?>
<!-- FR-SCN-22 (P2): long-press the app icon → Scan. The target is the relay
     activity in docukit_native, never MainActivity (ADR-065). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan_short"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="docukit://open/tool/scan?autostart=1"
            android:targetPackage="com.npmtechsolutions.docukit"
            android:targetClass="com.npmtechsolutions.docukit_native.ShortcutActivity" />
    </shortcut>
</shortcuts>
